# ============================================================
# The Lenny Growth Assistant - Backend Environment Configuration
# ============================================================

# Application
APP_NAME="The Lenny Growth Assistant"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ─────────────────────────────────────────────────────────
# PostgreSQL Relational Database
# ─────────────────────────────────────────────────────────
# LOCAL (non-Docker) — point at your local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
DB_ECHO=false

# DOCKER COMPOSE — these variables configure the managed postgres service.
# The backend service overrides DATABASE_URL automatically to use these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=lenny_assistant

# Optional port overrides (Docker Compose)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Qdrant Cloud Vector Database
# Note: Use your pre-existing Qdrant Cloud cluster endpoint and API key
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key-here
QDRANT_COLLECTION=lenny_transcripts
QDRANT_TIMEOUT=30.0

# LLM Providers Configuration
# Available options: "gemini" or "ollama"
LLM_PROVIDER=gemini

# Google Gemini Configuration (Official google-genai SDK)
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_API_KEY_FALLBACK=your-fallback-google-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Remote / Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# Embedding Model Configuration
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# Hybrid Retrieval & RRF Parameters
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RRF_TOP_K=20
RERANK_TOP_K=5

# Cross-Encoder Reranker Configuration
RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ─────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────
# Chat endpoint: requests per minute per authenticated user
RATE_LIMIT_CHAT_PER_MINUTE=20
# Auth endpoints (login/signup): requests per minute per IP
RATE_LIMIT_AUTH_PER_MINUTE=10
# Storage backend: "memory" (default, single-process) or "redis://..."
RATE_LIMIT_STORAGE_URI=memory://

# ─────────────────────────────────────────────────────────
# Ollama Streaming
# ─────────────────────────────────────────────────────────
# Enable real server-sent token streaming for Ollama responses
OLLAMA_STREAMING_ENABLED=true

# Transcripts Data Path
TRANSCRIPTS_DIR=D:/Projects/lenny-podcast/lennys-podcast-transcripts-main/lennys-podcast-transcripts-main/episodes
